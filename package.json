{
  "name": "feed-my-brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "node --env-file-if-exists=.env --import tsx pipeline/src/index.ts",
    "pipeline:dry": "node --env-file-if-exists=.env --import tsx pipeline/src/index.ts --dry",
    "notify": "node --env-file-if-exists=.env --import tsx pipeline/src/notify-cli.ts",
    "llm:check": "node --env-file-if-exists=.env --import tsx scripts/llm-check.ts",
    "vapid": "node --import tsx scripts/vapid.ts",
    "icons": "node --import tsx scripts/icons.ts",
    "api": "node --import tsx scripts/prepare-api.ts",
    "dev": "npm run api && vite",
    "build": "npm run api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p app/tsconfig.sw.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "preact": "^10.29.8",
    "workbox-expiration": "^7.4.1"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/web-push": "^3.6.4",
    "linkedom": "^0.18.13",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
