# LLM: basta una chiave, ma più ne metti più la pipeline regge i limiti dei piani gratuiti.
# Ogni *_MODEL accetta più modelli separati da virgola, provati in ordine con la stessa chiave.
# Ordine di preferenza: personalizzato → Mistral → NVIDIA → OpenRouter → Gemini → Groq → Hugging Face.

# Endpoint compatibile OpenAI (OmniRoute, OpenRouter, server locale…)
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_NAME=OmniRoute

# NVIDIA (https://build.nvidia.com), chiave "nvapi-..."
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b

# OpenRouter (https://openrouter.ai/keys), modelli gratuiti con suffisso ":free"
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free,google/gemma-4-31b-it:free

# Google Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq (https://console.groq.com/keys)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest

# Fallback quando Mistral esaurisce i limiti: Hugging Face Inference Providers
# Token da https://huggingface.co/settings/tokens (permesso "Make calls to Inference Providers")
HF_TOKEN=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# URL pubblico della PWA, usato come link nelle notifiche
APP_URL=https://davide-modena.github.io/feed-my-brain/

# Notifiche Web Push (genera le chiavi con `npm run vapid`)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_SUBSCRIPTION={"endpoint":"...","keys":{...}}

# Notifiche alternative via ntfy.sh (app gratuita Android/iOS)
# NTFY_TOPIC=
